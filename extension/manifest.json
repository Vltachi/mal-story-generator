{
  "manifest_version": 3,
  "name": "MAL Story Generator",
  "version": "2.0.0",
  "description": "Gera stories para Instagram quando você completa um anime ou manga no MyAnimeList.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MAL Story Generator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://myanimelist.net/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "identity", "tabs"],
  "host_permissions": [
    "*://myanimelist.net/*",
    "*://api.myanimelist.net/*",
    "*://myanimelist.net/v1/oauth2/token"
  ]
}
